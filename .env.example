# Copie para .env (local) e preencha. O .env fica fora do Git.
# No Streamlit Community Cloud, cole as mesmas variáveis no painel Secrets.
# Sem nenhuma chave, o Fullguete roda inteiro em modo local e simulado.

# Chave da API do Google Gemini, criada em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo leve por padrão. Troque se quiser outro modelo do Gemini.
GEMINI_MODEL=gemini-3.1-flash-lite

# Token do CNPJ.ws Comercial (opcional). Sem ele, usa a consulta pública, limitada a 3 por minuto.
CNPJ_WS_TOKEN=

# Caminho do banco SQLite.
FULLGUETE_DB_PATH=data/fullguete_v2.db

# simulado: libera os logins de demonstração e a base fictícia.
# real: só entram usuários cadastrados nos Secrets, com senha em hash.
FULLGUETE_MODO=simulado
