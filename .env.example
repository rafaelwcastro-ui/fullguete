# Copie para .env (local) e preencha. O .env fica fora do Git.
# No Streamlit Community Cloud, cole as mesmas variáveis no painel Secrets.
# Sem nenhuma chave, o Fullguete roda inteiro em modo local e simulado.

# Chave da API do Google Gemini, criada em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo leve por padrão. Troque se quiser outro modelo do Gemini.
GEMINI_MODEL=gemini-3.1-flash-lite

# Token do CNPJ.ws Comercial (opcional). Sem ele, usa a consulta pública, limitada a 3 por minuto.
CNPJ_WS_TOKEN=

# Busca real por cidade, CNAE/atividade e mês de abertura: https://api.localizacnpj.com.br/
# Chave gratuita cadastrada no provedor; também pode ser digitada temporariamente no portal.
LOCALIZA_CNPJ_TOKEN=

# Pesquisa de empresas via CNPJá Comercial, https://cnpja.com/api
# Teste temporário permitido na aba, sem gravar a chave no projeto.
CNPJA_API_KEY=

# Caminho do banco SQLite.
FULLGUETE_DB_PATH=data/fullguete_v2.db

# simulado: libera os logins de demonstração e a base fictícia.
# real: só entram usuários cadastrados nos Secrets, com senha em hash.
FULLGUETE_MODO=simulado

# Botões de login dos perfis fictícios (gestor, BDRs, executivo) com a senha pública fullguete-demo.
# auto: aparecem só quando não há usuários em [usuarios] nos Secrets. Use "nao" num link público.
FULLGUETE_LOGINS_DEMO=auto

# No modo simulado, monta na primeira abertura um mês fictício de operação (Dashboard e Indicadores com dados).
# Use "nao" para começar com o funil vazio.
FULLGUETE_CENARIO_DEMO=sim
