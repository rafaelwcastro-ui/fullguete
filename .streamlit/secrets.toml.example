# Copie para .streamlit/secrets.toml (local) ou cole no painel "Secrets" do Streamlit Cloud.
# NUNCA envie o secrets.toml para o GitHub.

# Chave da Anthropic (opcional). Sem ela, o portal usa a análise local.
ANTHROPIC_API_KEY = "sk-ant-..."

# Chave da OpenAI (opcional). Pode usar uma, outra ou as duas.
OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-5-mini"   # opcional: troca o modelo da OpenAI

# Chave do Google Gemini (opcional), criada em https://aistudio.google.com/apikey
GEMINI_API_KEY = "AIza..."
# GEMINI_MODEL = "gemini-3.8-flash"   # opcional: troca o modelo do Gemini

# Usuários do portal. Gere com:  python -m fullguete.auth <usuario> "Nome"
# Guarde apenas o hash, nunca a senha.
[usuarios.admin]
nome = "Administrador"
senha_hash = "pbkdf2_sha256$600000$<salt>$<hash>"
